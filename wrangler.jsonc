{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bentgrass-community-website",
  "compatibility_date": "2026-09-02",
  "main": "./dist/_worker.js",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  },
  "r2_buckets": [
    {
      "binding": "PHOTO_QUARANTINE",
      "bucket_name": "bentgrass-photo-quarantine"
    },
    {
      "binding": "PHOTO_PUBLIC",
      "bucket_name": "bentgrass-photo-public"
    }
  },
  "d1_databases": [
    {
      "binding": "RESIDENT_DB",
      "database_name": "bentgrass-residents",
      "database_id": "REPLACE_WITH_D1_DATABASE_ID",
      "migrations_dir": "migrations"
    }
  }
  // Once the domain's zone is active on Cloudflare (see README "Deployment"),
  // either add a Custom Domain via the dashboard, or uncomment:
  // "routes": [{ "pattern": "www.bentgrassneighborhood.org", "custom_domain": true }]
}
