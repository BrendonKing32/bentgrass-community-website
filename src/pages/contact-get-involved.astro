---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHeader from "../components/PageHeader.astro";

const officialContacts = [
  { issue: "Covenants & district matters", contact: "Bent Grass Metropolitan District", href: "https://bentgrassmd.colorado.gov" },
  { issue: "Zoning & property issues", contact: "El Paso County Code Enforcement", href: "https://www.elpasoco.com/" },
  { issue: "Non-emergency law enforcement", contact: "El Paso County Sheriff's Office", href: "https://epcsheriffsoffice.com/" },
  { issue: "Emergencies", contact: "911", href: "tel:911" },
];

const contactEmail = "bentgrassneighborhood@gmail.com";
const mailto = (subject: string) => `mailto:${contactEmail}?subject=${encodeURIComponent(subject)}`;

const waysToHelp = [
  { label: "Share news, road closures, lost pets, events, or safety notices", subject: "Neighborhood news to share" },
  { label: "Volunteer at neighborhood events (cleanups, yard sales, setup/logistics)", subject: "Volunteering at neighborhood events" },
  { label: "Report broken links or outdated information", subject: "Broken link or outdated info on the website" },
  { label: "Suggest missing resources or topics", subject: "Suggestion for a resource or topic" },
  { label: "Help maintain the website or coordinate events behind the scenes", subject: "Helping behind the scenes" },
];
---

<BaseLayout title="Contact / Get Involved" description="Reach the volunteers behind this site, or find out who to contact for official matters.">
  <PageHeader
    eyebrow="Run by neighbors, for neighbors"
    title="Contact / Get Involved"
    description="Questions, updates, or want to volunteer? We'd love to hear from you."
  />

  <section class="mx-auto max-w-5xl px-4 py-12 sm:px-6">
    <div class="mb-8">
      <a
        href={mailto("Hello from a neighbor")}
        class="inline-flex items-center rounded-md bg-brand-700 px-5 py-3 font-semibold text-white hover:bg-brand-800 focus:outline-none focus:ring-2 focus:ring-accent-400 focus:ring-offset-2"
      >
        Email the neighbors
      </a>
    </div>
    <div class="grid gap-8 lg:grid-cols-2">
      <div class="rounded-2xl border border-brand-200 bg-white p-6 shadow-sm dark:border-brand-800 dark:bg-brand-900">
        <h2 class="font-display text-xl font-semibold text-brand-900 dark:text-brand-50">Get in touch</h2>
        <ul class="mt-4 space-y-3 text-brand-700 dark:text-brand-200">
          <li>
            <a href={`mailto:${contactEmail}`} class="font-semibold text-brand-800 hover:text-brand-900 dark:text-brand-100 dark:hover:text-white">
              {contactEmail}
            </a>
          </li>
          <li>
            <a href="tel:+17194011119" class="font-semibold text-brand-800 hover:text-brand-900 dark:text-brand-100 dark:hover:text-white">(719) 401-1119</a>
          </li>
          <li>
            <a href="https://www.facebook.com/groups/bentgrassmeadows" target="_blank" rel="noopener" class="font-semibold text-brand-800 hover:text-brand-900 dark:text-brand-100 dark:hover:text-white">
              Bent Grass Neighbors Facebook Page
            </a>
          </li>
        </ul>
        <p class="mt-4 text-sm text-brand-700 dark:text-brand-400">
          This site is volunteer-run and not monitored in real time — for anything urgent, use the official
          contacts below.
        </p>
      </div>

      <div class="rounded-2xl border border-brand-200 bg-white p-6 shadow-sm dark:border-brand-800 dark:bg-brand-900">
        <h2 class="font-display text-xl font-semibold text-brand-900 dark:text-brand-50">Ways to get involved</h2>
        <ul class="mt-4 space-y-2 text-brand-700 dark:text-brand-200">
          {waysToHelp.map((item) => (
            <li class="flex gap-2">
              <span class="text-brand-500 dark:text-brand-400" aria-hidden="true">•</span>
              <a href={mailto(item.subject)} class="font-medium text-brand-800 underline decoration-brand-300 underline-offset-2 hover:text-brand-900 dark:text-brand-100 dark:decoration-brand-600 dark:hover:text-white">
                {item.label}
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>

    <div class="mt-8 overflow-hidden rounded-2xl border border-brand-200 bg-white shadow-sm dark:border-brand-800 dark:bg-brand-900">
      <div class="border-b border-brand-200 bg-brand-50 px-6 py-4 dark:border-brand-800 dark:bg-brand-900/60">
        <h2 class="font-display text-xl font-semibold text-brand-900 dark:text-brand-50">Official contacts for specific issues</h2>
      </div>
      <table class="w-full text-left text-sm">
        <tbody class="divide-y divide-brand-100 dark:divide-brand-800">
          {officialContacts.map((row) => (
            <tr>
              <td class="px-6 py-4 text-brand-700 dark:text-brand-200">{row.issue}</td>
              <td class="px-6 py-4">
                <a href={row.href} target={row.href.startsWith("tel:") ? undefined : "_blank"} rel="noopener" class="font-semibold text-brand-800 hover:text-brand-900 dark:text-brand-100 dark:hover:text-white">
                  {row.contact}
                </a>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>
</BaseLayout>
