---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHeader from "../../components/PageHeader.astro";
import ResourceNav from "../../components/ResourceNav.astro";
import { getEntry, render } from "astro:content";

const entry = await getEntry("pages", "bgmd");
const { Content } = await render(entry!);
---

<BaseLayout title="Bent Grass District: covenants & ARC (BGMD)" description="What the Bent Grass Metropolitan District does, covenants, and how to reach them.">
  <PageHeader eyebrow="Community Resources" eyebrowHref="/community-resources" title="Bent Grass District: covenants & ARC (BGMD)" />
  <ResourceNav current="/community-resources/bgmd-information" />
  <section class="mx-auto max-w-3xl px-4 py-12 sm:px-6">
    <div class="prose max-w-none prose-headings:font-display">
      <Content />
    </div>
  </section>
</BaseLayout>
