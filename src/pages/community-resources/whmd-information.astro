---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHeader from "../../components/PageHeader.astro";
import { getEntry, render } from "astro:content";

const entry = await getEntry("pages", "whmd");
const { Content } = await render(entry!);
---

<BaseLayout title="WHMD Information" description="What the Woodmen Hills Metropolitan District does, and how to reach them.">
  <PageHeader eyebrow="Community Resources" title="WHMD Information" />
  <section class="mx-auto max-w-3xl px-4 py-12 sm:px-6">
    <div class="prose max-w-none prose-headings:font-display prose-a:text-brand-700">
      <Content />
    </div>
  </section>
</BaseLayout>
