---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHeader from "../components/PageHeader.astro";
import CalendarView from "../components/CalendarView.astro";
import { getCollection } from "astro:content";

const allEvents = await getCollection("events");
---

<BaseLayout title="Events & Calendar" description="Browse upcoming and past events in the Bent Grass neighborhood by month.">
  <PageHeader
    eyebrow="What's happening"
    title="Events & Calendar"
    description="Browse neighborhood happenings by month, open a day for details, and download events for your own calendar."
  />
  <CalendarView events={allEvents} />
</BaseLayout>
