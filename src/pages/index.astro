---
import BaseLayout from "../layouts/BaseLayout.astro";
import NewsCard from "../components/NewsCard.astro";
import EventCard from "../components/EventCard.astro";
import NewsletterSignup from "../components/NewsletterSignup.astro";
import { getCollection } from "astro:content";

const news = (await getCollection("news")).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf()).slice(0, 3);

// Compare calendar days in the neighborhood's timezone, so an event stays
// "upcoming" through its own day. Front-matter dates are UTC midnight.
const todayKey = new Intl.DateTimeFormat("en-CA", { timeZone: "America/Denver" }).format(new Date());
const endKey = (entry: { data: { date: Date; endDate?: Date } }) =>
  (entry.data.endDate ?? entry.data.date).toISOString().slice(0, 10);

// Render a few extra candidates; the script below hides ones that have ended
// since the last build and shows the first three.
const UPCOMING_LIMIT = 3;
const upcomingEvents = (await getCollection("events"))
  .filter((e) => endKey(e) >= todayKey)
  .sort((a, b) => a.data.date.valueOf() - b.data.date.valueOf())
  .slice(0, UPCOMING_LIMIT * 2);

// "Who do I contact?" rows. Every entry mirrors an answer already published in
// src/content/faq or src/content/pages — keep them in sync if those change.
const contactTopics = [
  {
    topic: "Water, sewer, or watering restrictions",
    who: "Woodmen Hills Metro District (WHMD)",
    href: "/community-resources/whmd-information",
  },
  {
    topic: "Pocket parks, drainage, or entry monuments",
    who: "Bent Grass Metro District (BGMD)",
    href: "/community-resources/bgmd-information",
  },
  {
    topic: "Fence, shed, deck, paint, or landscaping changes",
    who: "BGMD Architectural Committee — approval comes first",
    href: "/faq#faq-09-approval-before-changes",
  },
  {
    topic: "A neighbor's yard or exterior",
    who: "BGMD for covenant issues, El Paso County for code issues",
    href: "/faq#faq-11-covenant-vs-county-violation",
  },
  {
    topic: "Roads and streets",
    who: "BGMD or El Paso County, depending on who owns the street",
    href: "/faq#faq-21-road-improvements",
  },
  {
    topic: "Safety, emergencies, or fire restrictions",
    who: "911, the Sheriff's Office, or Falcon Fire Protection District",
    href: "/faq#faq-22-safety-contact",
  },
  {
    topic: "Problems with a new home",
    who: "Challenger Homes warranty team",
    href: "/faq#faq-19-home-warranty",
  },
  {
    topic: "District board meetings",
    who: "BGMD (1st Tuesday) and WHMD (4th Thursday)",
    href: "/faq#faq-05-board-meetings",
  },
];

const quickActions = [
  {
    label: "Submit an architectural request",
    href: "https://bentgrassmd.colorado.gov",
    external: true,
  },
  { label: "Find a board meeting", href: "/faq#faq-05-board-meetings" },
  { label: "Join the Facebook group", href: "https://www.facebook.com/groups/bentgrassmeadows", external: true },
  { label: "Get the newsletter", href: "#newsletter" },
];
---

<BaseLayout title="Bent Grass Neighborhood">
  <section class="relative overflow-hidden bg-brand-900">
    <div class="absolute inset-0 bg-[radial-gradient(circle_at_top_right,rgba(123,171,97,0.35),transparent_55%)]"></div>
    <div class="relative mx-auto max-w-6xl px-4 py-20 sm:px-6 sm:py-28">
      <p class="text-sm font-semibold uppercase tracking-widest text-brand-300">Falcon / Peyton, Colorado</p>
      <h1 class="mt-3 max-w-2xl font-display text-4xl font-semibold text-white sm:text-5xl">
        Welcome to Bent Grass!
      </h1>
      <p class="mt-5 max-w-2xl text-lg text-brand-100">
        A volunteer-led community resource created by local residents to make it easier to navigate neighborhood
        life — events, local resources, and guidance on who to contact for common questions.
      </p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a href="/events-calendar" class="rounded-full bg-accent-500 px-6 py-3 text-sm font-semibold text-brand-950 shadow hover:bg-accent-400">
          See what's happening
        </a>
        <a href="/faq" class="rounded-full border border-brand-400 px-6 py-3 text-sm font-semibold text-white hover:bg-brand-800">
          Browse the FAQ
        </a>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 py-8 sm:px-6">
    <div class="rounded-2xl border border-brand-200 bg-white p-5 text-sm text-brand-700 shadow-sm dark:border-brand-800 dark:bg-brand-900 dark:text-brand-200">
      Bent Grass sits within two overlapping metro districts — <strong>Woodmen Hills Metro District (WHMD)</strong>
      and <strong>Bent Grass Metro District (BGMD)</strong>. With multiple entities providing services, it's easy to
      get confused about who to contact. This site consolidates events, resources, and guidance in one place.
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 py-6 sm:px-6" aria-labelledby="who-to-contact">
    <h2 id="who-to-contact" class="font-display text-2xl font-semibold text-brand-900 dark:text-brand-50">Who do I contact about…?</h2>
    <p class="mt-2 text-brand-700 dark:text-brand-200">Pick your situation to see who handles it and the full answer.</p>
    <ul class="mt-5 grid gap-3 md:grid-cols-2">
      {contactTopics.map((item) => (
        <li>
          <a
            href={item.href}
            class="group flex h-full items-center justify-between gap-4 rounded-2xl border border-brand-200 bg-white p-4 shadow-sm transition hover:border-brand-400 hover:shadow-md dark:border-brand-800 dark:bg-brand-900 dark:hover:border-brand-600"
          >
            <span>
              <span class="block font-semibold text-brand-900 dark:text-brand-50">{item.topic}</span>
              <span class="mt-1 block text-sm text-brand-700 dark:text-brand-200">{item.who}</span>
            </span>
            <span class="shrink-0 text-brand-500 transition group-hover:translate-x-0.5 dark:text-brand-300" aria-hidden="true">&rarr;</span>
          </a>
        </li>
      ))}
    </ul>
    <p class="mt-4 text-sm text-brand-700 dark:text-brand-200">
      Not on the list? <a href="/faq" class="font-semibold underline hover:text-brand-900 dark:hover:text-white">Browse the full FAQ</a>
      or <a href="/contact-get-involved" class="font-semibold underline hover:text-brand-900 dark:hover:text-white">reach out to us</a>.
    </p>
  </section>

  <section class="mx-auto max-w-6xl px-4 py-6 sm:px-6" aria-labelledby="common-tasks">
    <h2 id="common-tasks" class="font-display text-2xl font-semibold text-brand-900 dark:text-brand-50">Common tasks</h2>
    <ul class="mt-4 flex flex-wrap gap-3">
      {quickActions.map((action) => (
        <li>
          <a
            href={action.href}
            {...(action.external ? { target: "_blank", rel: "noopener noreferrer" } : {})}
            class="inline-flex min-h-11 items-center rounded-full border border-brand-300 px-5 py-2 text-sm font-semibold text-brand-800 hover:bg-brand-100 dark:border-brand-700 dark:text-brand-100 dark:hover:bg-brand-900"
          >
            {action.label}
            {action.external && <span class="sr-only"> (opens in a new tab)</span>}
          </a>
        </li>
      ))}
    </ul>
  </section>

  {upcomingEvents.length > 0 && (
    <section class="mx-auto max-w-6xl px-4 py-10 sm:px-6" data-upcoming-section data-limit={UPCOMING_LIMIT}>
      <div class="flex items-baseline justify-between">
        <h2 class="font-display text-2xl font-semibold text-brand-900 dark:text-brand-50">Upcoming Events</h2>
        <a href="/events-calendar" class="text-sm font-semibold text-brand-700 hover:text-brand-900 dark:text-brand-200 dark:hover:text-white">View all &rarr;</a>
      </div>
      <div class="mt-5 grid gap-5 md:grid-cols-3">
        {upcomingEvents.map((event, index) => (
          <div class:list={["grid", { hidden: index >= UPCOMING_LIMIT }]} data-upcoming-event data-end={endKey(event)}>
            <EventCard entry={event} />
          </div>
        ))}
      </div>
    </section>
  )}

  {news.length > 0 && (
    <section class="mx-auto max-w-6xl px-4 py-10 sm:px-6">
      <div class="flex items-baseline justify-between">
        <h2 class="font-display text-2xl font-semibold text-brand-900 dark:text-brand-50">Latest News</h2>
        <a href="/news-announcements" class="text-sm font-semibold text-brand-700 hover:text-brand-900 dark:text-brand-200 dark:hover:text-white">View all &rarr;</a>
      </div>
      <div class="mt-5 grid gap-5 md:grid-cols-3">
        {news.map((item) => <NewsCard entry={item} compact />)}
      </div>
    </section>
  )}

  <section id="newsletter" class="mx-auto max-w-6xl scroll-mt-24 px-4 py-10 sm:px-6">
    <div class="rounded-3xl bg-brand-700 px-6 py-10 text-center sm:px-12">
      <h2 class="font-display text-2xl font-semibold text-white">Stay in the loop</h2>
      <p class="mx-auto mt-3 max-w-xl text-brand-100">
        Get the Bent Grass Neighbors newsletter in your inbox — event updates, announcements, and neighborhood tips,
        once a month.
      </p>
      <div class="mt-6">
        <NewsletterSignup variant="dark" />
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  // The list above is computed at build time; drop events that have ended
  // since then so the homepage stays accurate between rebuilds.
  const section = document.querySelector<HTMLElement>("[data-upcoming-section]");
  if (section) {
    const limit = Number(section.dataset.limit) || 3;
    const todayKey = new Intl.DateTimeFormat("en-CA", { timeZone: "America/Denver" }).format(new Date());
    let shown = 0;
    section.querySelectorAll<HTMLElement>("[data-upcoming-event]").forEach((item) => {
      const visible = (item.dataset.end ?? "") >= todayKey && shown < limit;
      item.classList.toggle("hidden", !visible);
      if (visible) shown += 1;
    });
    if (shown === 0) section.hidden = true;
  }
</script>
