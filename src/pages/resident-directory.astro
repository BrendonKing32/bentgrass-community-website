---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHeader from "../components/PageHeader.astro";
---

<BaseLayout title="Resident Directory" description="Private directory for verified Bent Grass residents." privatePage>
  <PageHeader
    eyebrow="Private resident access"
    title="Resident Directory"
    description="This directory is not public. Access is limited to residents whose address has been verified by a community administrator."
  />

  <section class="mx-auto max-w-5xl space-y-8 px-4 py-12 sm:px-6">
    <div id="status" class="rounded-2xl border border-brand-200 bg-white p-6 shadow-sm dark:border-brand-800 dark:bg-brand-900">
      <h2 class="font-display text-xl font-semibold text-brand-900 dark:text-brand-50">Sign in</h2>
      <p class="mt-2 text-brand-700 dark:text-brand-200">Enter the email address associated with your approved resident account. We will email you a one-time sign-in link.</p>
      <form id="login-form" class="mt-5 flex flex-col gap-3 sm:flex-row">
        <label class="sr-only" for="login-email">Email address</label>
        <input id="login-email" name="email" type="email" required autocomplete="email" placeholder="you@example.com" class="min-w-0 flex-1 rounded-md border border-brand-300 bg-white px-3 py-2 dark:border-brand-700 dark:bg-brand-950" />
        <button class="rounded-md bg-brand-700 px-4 py-2 font-semibold text-white hover:bg-brand-800" type="submit">Email me a sign-in link</button>
      </form>
      <p id="login-message" class="mt-3 text-sm text-brand-600 dark:text-brand-300"></p>
      <p class="mt-4 text-sm text-brand-500 dark:text-brand-400">Not verified yet? <a class="font-semibold underline" href="/resident-directory/apply">Apply for access</a>.</p>
    </div>

    <div id="directory" class="hidden">
      <div class="flex flex-wrap items-center justify-between gap-3">
        <div>
          <h2 class="font-display text-2xl font-semibold text-brand-900 dark:text-brand-50">Approved residents</h2>
          <p class="mt-1 text-sm text-brand-600 dark:text-brand-300">Contact details appear only when the resident has opted in.</p>
        </div>
        <button id="logout" class="rounded-md border border-brand-300 px-3 py-2 text-sm font-semibold text-brand-800 dark:border-brand-700 dark:text-brand-100" type="button">Sign out</button>
      </div>
      <div id="directory-list" class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-3"></div>
      <details class="mt-8 rounded-2xl border border-brand-200 bg-white p-5 dark:border-brand-800 dark:bg-brand-900">
        <summary class="cursor-pointer font-semibold text-brand-900 dark:text-brand-50">Privacy settings</summary>
        <form id="profile-form" class="mt-4 space-y-4">
          <label class="block text-sm font-semibold">Phone<input name="phone" type="tel" autocomplete="tel" class="mt-1 w-full rounded-md border border-brand-300 px-3 py-2 dark:border-brand-700 dark:bg-brand-950" /></label>
          <label class="block text-sm font-semibold">Miscellaneous information<textarea name="misc" rows="3" class="mt-1 w-full rounded-md border border-brand-300 px-3 py-2 dark:border-brand-700 dark:bg-brand-950"></textarea></label>
          <label class="flex gap-2 text-sm"><input name="showEmail" type="checkbox" /> Show my email address to approved residents</label>
          <label class="flex gap-2 text-sm"><input name="showPhone" type="checkbox" /> Show my phone number to approved residents</label>
          <button class="rounded-md bg-brand-700 px-4 py-2 font-semibold text-white hover:bg-brand-800" type="submit">Save privacy settings</button>
          <p id="profile-message" class="text-sm text-brand-600 dark:text-brand-300"></p>
        </form>
      </details>
      <p class="mt-6 text-sm text-brand-500 dark:text-brand-400">Want your contact information hidden or removed? Contact the site administrators.</p>
    </div>
  </section>
</BaseLayout>

<script>
  interface ResidentRecord {
    first_name: string;
    last_name: string;
    misc: string | null;
    email: string | null;
    phone: string | null;
  }

  const loginForm = document.querySelector<HTMLFormElement>("#login-form");
  const loginMessage = document.querySelector<HTMLElement>("#login-message");
  const directory = document.querySelector<HTMLElement>("#directory");
  const status = document.querySelector<HTMLElement>("#status");
  const list = document.querySelector<HTMLElement>("#directory-list");
  const profileForm = document.querySelector<HTMLFormElement>("#profile-form");
  const profileMessage = document.querySelector<HTMLElement>("#profile-message");

  function renderResidents(residents: ResidentRecord[]) {
    if (!list) return;
    list.replaceChildren();
    residents.forEach((resident) => {
      const card = document.createElement("article");
      card.className = "rounded-2xl border border-brand-200 bg-white p-5 shadow-sm dark:border-brand-800 dark:bg-brand-900";
      const name = document.createElement("h3");
      name.className = "font-semibold text-brand-900 dark:text-brand-50";
      name.textContent = `${resident.first_name} ${resident.last_name}`;
      card.append(name);
      if (resident.misc) {
        const misc = document.createElement("p");
        misc.className = "mt-2 text-sm text-brand-700 dark:text-brand-200";
        misc.textContent = resident.misc;
        card.append(misc);
      }
      [resident.email, resident.phone].filter(Boolean).forEach((value) => {
        const link = document.createElement("a");
        link.className = "mt-3 block text-sm font-semibold text-brand-700 underline dark:text-accent-300";
        link.href = value.includes("@") ? `mailto:${value}` : `tel:${value}`;
        link.textContent = value;
        card.append(link);
      });
      list.append(card);
    });
  }

  async function loadDirectory() {
    if (!status || !directory || !profileForm) return;
    const response = await fetch("/api/resident/directory");
    if (!response.ok) return;
    const data = await response.json();
    renderResidents(data.residents);
    const profileResponse = await fetch("/api/resident/profile");
    if (profileResponse.ok) {
      const { resident } = await profileResponse.json();
      const phone = profileForm.elements.namedItem("phone");
      const misc = profileForm.elements.namedItem("misc");
      const showEmail = profileForm.elements.namedItem("showEmail");
      const showPhone = profileForm.elements.namedItem("showPhone");
      if (phone instanceof HTMLInputElement && misc instanceof HTMLTextAreaElement) {
        phone.value = resident.phone ?? "";
        misc.value = resident.misc ?? "";
      }
      if (showEmail instanceof HTMLInputElement && showPhone instanceof HTMLInputElement) {
        showEmail.checked = resident.showEmail;
        showPhone.checked = resident.showPhone;
      }
    }
    status.classList.add("hidden");
    directory.classList.remove("hidden");
  }

  profileForm?.addEventListener("submit", async (event) => {
    event.preventDefault();
    if (!profileForm) return;
    const response = await fetch("/api/resident/profile", { method: "POST", body: new FormData(profileForm) });
    if (profileMessage) profileMessage.textContent = response.ok ? "Privacy settings saved." : "We could not save your settings.";
  });

  loginForm?.addEventListener("submit", async (event) => {
    event.preventDefault();
    if (!loginForm) return;
    if (loginMessage) loginMessage.textContent = "If that email belongs to an approved resident, a sign-in link is on its way.";
    const response = await fetch("/api/resident/request-link", { method: "POST", body: new FormData(loginForm) });
    if (!response.ok && loginMessage) loginMessage.textContent = "We could not send a sign-in link right now. Please try again later.";
  });

  document.querySelector<HTMLButtonElement>("#logout")?.addEventListener("click", async () => {
    await fetch("/api/resident/logout", { method: "POST" });
    window.location.reload();
  });

  loadDirectory();
</script>
