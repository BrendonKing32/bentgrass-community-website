---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHeader from "../../components/PageHeader.astro";
---

<BaseLayout title="Apply for Resident Directory Access" privatePage>
  <PageHeader
    eyebrow="Private resident access"
    title="Apply for directory access"
    description="Applications are reviewed by community administrators. Your address is used for verification and is not displayed in the directory."
  />
  <section class="mx-auto max-w-2xl px-4 py-12 sm:px-6">
    <form id="application-form" class="space-y-5 rounded-2xl border border-brand-200 bg-white p-6 shadow-sm dark:border-brand-800 dark:bg-brand-900">
      <div class="grid gap-5 sm:grid-cols-2">
        <label class="block text-sm font-semibold">First name<input name="firstName" required class="mt-1 w-full rounded-md border border-brand-300 px-3 py-2 dark:border-brand-700 dark:bg-brand-950" /></label>
        <label class="block text-sm font-semibold">Last name<input name="lastName" required class="mt-1 w-full rounded-md border border-brand-300 px-3 py-2 dark:border-brand-700 dark:bg-brand-950" /></label>
      </div>
      <label class="block text-sm font-semibold">Community address<input name="address" required autocomplete="street-address" class="mt-1 w-full rounded-md border border-brand-300 px-3 py-2 dark:border-brand-700 dark:bg-brand-950" /></label>
      <label class="block text-sm font-semibold">Email<input name="email" type="email" required autocomplete="email" class="mt-1 w-full rounded-md border border-brand-300 px-3 py-2 dark:border-brand-700 dark:bg-brand-950" /></label>
      <label class="block text-sm font-semibold">Phone <span class="font-normal">(optional)</span><input name="phone" type="tel" autocomplete="tel" class="mt-1 w-full rounded-md border border-brand-300 px-3 py-2 dark:border-brand-700 dark:bg-brand-950" /></label>
      <label class="block text-sm font-semibold">Anything else to share? <span class="font-normal">(optional)</span><textarea name="misc" rows="3" class="mt-1 w-full rounded-md border border-brand-300 px-3 py-2 dark:border-brand-700 dark:bg-brand-950"></textarea></label>
      <p class="text-sm text-brand-600 dark:text-brand-300">Email and phone are hidden from the directory by default. You can choose whether to display them after approval.</p>
      <button class="rounded-md bg-brand-700 px-4 py-2 font-semibold text-white hover:bg-brand-800" type="submit">Submit application</button>
      <p id="application-message" class="text-sm" role="status"></p>
    </form>
  </section>
</BaseLayout>

<script>
  const form = document.querySelector("#application-form");
  const message = document.querySelector("#application-message");
  form.addEventListener("submit", async (event) => {
    event.preventDefault();
    const response = await fetch("/api/resident/apply", { method: "POST", body: new FormData(form) });
    message.textContent = response.ok ? "Thanks. Your application was submitted for administrator review." : "We could not submit your application. Please try again later.";
    message.className = response.ok ? "text-sm text-brand-700 dark:text-brand-200" : "text-sm text-red-700";
    if (response.ok) form.reset();
  });
</script>
