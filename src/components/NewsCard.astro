---
import { render } from "astro:content";
import type { CollectionEntry } from "astro:content";
import { Image } from "astro:assets";

interface Props {
  entry: CollectionEntry<"news">;
  compact?: boolean;
}

const { entry, compact = false } = Astro.props;
const { Content } = await render(entry);
const { coverImage, coverImageAlt, title } = entry.data;
const formattedDate = entry.data.date.toLocaleDateString("en-US", {
  year: "numeric",
  month: "long",
  day: "numeric",
});
---

<article id={`news-${entry.id}`} class="overflow-hidden rounded-2xl border border-brand-200 bg-white shadow-sm">
  {coverImage && (
    <Image
      src={coverImage}
      alt={coverImageAlt ?? title}
      width={640}
      height={360}
      class="aspect-video w-full object-cover"
      loading="lazy"
    />
  )}
  <div class="p-6">
    <p class="text-xs font-semibold uppercase tracking-wide text-brand-500">{formattedDate}</p>
    <h3 class="mt-1 font-display text-xl font-semibold text-brand-900">{entry.data.title}</h3>
    {compact ? (
      <p class="mt-2 text-brand-700">{entry.data.summary}</p>
    ) : (
      <div class="prose prose-sm mt-3 max-w-none text-brand-800 prose-headings:font-display">
        <Content />
      </div>
    )}
  </div>
</article>
