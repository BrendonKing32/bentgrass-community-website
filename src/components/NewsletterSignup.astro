---
interface Props {
  /** Tailwind classes controlling the color scheme of the surrounding card. */
  variant?: "dark" | "light";
}

const { variant = "dark" } = Astro.props;
const dark = variant === "dark";
---

<div class:list={["newsletter-signup", dark ? "text-brand-100" : "text-brand-700"]} data-variant={variant}>
  <form method="POST" action="/api/subscribe" class="mx-auto flex max-w-md flex-col gap-3 sm:flex-row" data-newsletter-form>
    <label class="sr-only" for="newsletter-email">Email address</label>
    <input
      id="newsletter-email"
      type="email"
      name="email"
      required
      placeholder="you@example.com"
      class="min-w-0 flex-1 rounded-full border border-brand-300 bg-white px-5 py-3 text-sm text-brand-950 shadow-sm focus:border-brand-500 focus:outline-none focus:ring-2 focus:ring-brand-500"
    />
    <!-- Honeypot field: hidden from real visitors, bots tend to fill every field in. -->
    <input type="text" name="company" tabindex="-1" autocomplete="off" class="hidden" aria-hidden="true" />
    <input type="hidden" name="redirect" value="" data-newsletter-redirect />
    <button
      type="submit"
      class="inline-flex items-center justify-center rounded-full bg-accent-500 px-6 py-3 text-sm font-semibold text-brand-950 shadow hover:bg-accent-400"
    >
      Subscribe
    </button>
  </form>
  <p class="mt-3 text-sm" data-newsletter-message hidden></p>
</div>

<script>
  document.querySelectorAll<HTMLInputElement>("[data-newsletter-redirect]").forEach((field) => {
    field.value = window.location.pathname;
  });

  const messages: Record<string, { text: string; tone: "success" | "error" }> = {
    success: { text: "Almost there! Check your inbox for a confirmation email to complete your subscription.", tone: "success" },
    invalid: { text: "That doesn't look like a valid email address — mind trying again?", tone: "error" },
    error: { text: "Something went wrong on our end — mind trying again in a bit?", tone: "error" },
    blocked: { text: "We couldn't complete that signup — if this keeps happening, email us and we'll add you by hand.", tone: "error" },
  };

  const params = new URLSearchParams(window.location.search);
  const status = params.get("subscribed");
  if (status && messages[status]) {
    const { text, tone } = messages[status];
    document.querySelectorAll<HTMLParagraphElement>("[data-newsletter-message]").forEach((el) => {
      const wrapper = el.closest<HTMLElement>(".newsletter-signup");
      const isDark = wrapper?.dataset.variant !== "light";
      el.textContent = text;
      el.hidden = false;
      el.classList.remove("text-accent-200", "text-red-300", "text-brand-700", "text-red-600");
      if (tone === "success") {
        el.classList.add(isDark ? "text-accent-200" : "text-brand-700");
      } else {
        el.classList.add(isDark ? "text-red-300" : "text-red-600");
      }
    });
    params.delete("subscribed");
    const newSearch = params.toString();
    window.history.replaceState({}, "", window.location.pathname + (newSearch ? `?${newSearch}` : ""));
  }
</script>
