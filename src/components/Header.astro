---
const navLinks = [
  { label: "Home", href: "/" },
  { label: "News", href: "/news-announcements" },
  { label: "Events", href: "/events-calendar" },
  {
    label: "Community Resources",
    href: "/community-resources/general-resources",
    children: [
      { label: "General Resources", href: "/community-resources/general-resources" },
      { label: "WHMD Information", href: "/community-resources/whmd-information" },
      { label: "BGMD Information", href: "/community-resources/bgmd-information" },
      { label: "Monthly Newsletters", href: "/community-resources/monthly-newsletters" },
    ],
  },
  { label: "FAQ", href: "/faq" },
  { label: "Gallery", href: "/community-gallery" },
  { label: "Contact", href: "/contact-get-involved" },
];

const currentPath = Astro.url.pathname.replace(/\/$/, "") || "/";

function isActive(href: string) {
  const normalized = href.replace(/\/$/, "") || "/";
  return currentPath === normalized || (normalized !== "/" && currentPath.startsWith(normalized));
}
---

<header class="sticky top-0 z-50 border-b border-brand-200 bg-brand-50/95 backdrop-blur dark:border-brand-800 dark:bg-brand-950/95">
  <div class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-4 py-3 sm:px-6">
    <a href="/" class="flex items-center gap-2 font-display text-lg font-semibold text-brand-800">
      <span
        class="flex h-9 w-9 items-center justify-center rounded-full bg-brand-600 text-brand-50"
        aria-hidden="true"
      >
        🌾
      </span>
      Bent Grass Neighborhood
    </a>

    <details class="group relative">
      <summary
        class="flex cursor-pointer list-none items-center justify-center rounded-md border border-brand-300 p-2 text-brand-700 [&::-webkit-details-marker]:hidden dark:border-brand-700 dark:text-brand-200"
        aria-label="Search the site"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-4.35-4.35M17 11a6 6 0 11-12 0 6 6 0 0112 0z" />
        </svg>
      </summary>
      <div class="absolute right-0 z-50 mt-2 w-80 max-w-[90vw] rounded-xl border border-brand-200 bg-white p-3 shadow-lg sm:w-96 dark:border-brand-800 dark:bg-brand-900" data-search-panel>
        <input
          type="search"
          data-search-input
          placeholder="Search news, events, FAQ, resources…"
          autocomplete="off"
          class="w-full rounded-md border border-brand-300 bg-white px-3 py-2 text-sm text-brand-900 focus:outline-none focus:ring-2 focus:ring-accent-400 focus:ring-offset-2 dark:border-brand-700 dark:bg-brand-950 dark:text-brand-50"
        />
        <ul data-search-results class="mt-2 max-h-80 overflow-y-auto"></ul>
        <p data-search-empty class="mt-2 hidden text-sm text-brand-600 dark:text-brand-300">No results found.</p>
        <p data-search-hint class="mt-2 text-sm text-brand-500 dark:text-brand-400">Start typing to search the site…</p>
      </div>
    </details>

    <button
      type="button"
      data-theme-toggle
      class="flex cursor-pointer items-center justify-center rounded-md border border-brand-300 p-2 text-brand-700 dark:border-brand-700 dark:text-brand-200"
      aria-label="Toggle dark mode"
    >
      <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 dark:hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 1020.354 15.354z" />
      </svg>
      <svg xmlns="http://www.w3.org/2000/svg" class="hidden h-5 w-5 dark:block" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <circle cx="12" cy="12" r="4" />
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          d="M12 2v2m0 16v2m10-10h-2M4 12H2m15.364 7.364l-1.414-1.414M6.05 6.05L4.636 4.636m12.728 0l-1.414 1.414M6.05 17.95l-1.414 1.414"
        />
      </svg>
    </button>

    <details class="group relative lg:hidden">
      <summary
        class="flex cursor-pointer list-none items-center justify-center rounded-md border border-brand-300 p-2 text-brand-700 [&::-webkit-details-marker]:hidden dark:border-brand-700 dark:text-brand-200"
        aria-label="Toggle menu"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </summary>
      <nav
        class="absolute right-0 z-50 mt-2 w-64 rounded-xl border border-brand-200 bg-white p-3 shadow-lg dark:border-brand-800 dark:bg-brand-900"
        aria-label="Mobile navigation"
      >
        <ul class="flex flex-col gap-1">
          {navLinks.map((link) => (
            <li>
              {link.children ? (
                <details>
                  <summary class="cursor-pointer rounded-md px-3 py-2 font-medium text-brand-800 hover:bg-brand-50 [&::-webkit-details-marker]:hidden dark:text-brand-100 dark:hover:bg-brand-800">
                    {link.label}
                  </summary>
                  <ul class="ml-3 mt-1 flex flex-col gap-1 border-l border-brand-100 pl-3 dark:border-brand-800">
                    {link.children.map((child) => (
                      <li>
                        <a href={child.href} class="block rounded-md px-3 py-2 text-sm text-brand-700 hover:bg-brand-50 dark:text-brand-200 dark:hover:bg-brand-800">
                          {child.label}
                        </a>
                      </li>
                    ))}
                  </ul>
                </details>
              ) : (
                <a href={link.href} class="block rounded-md px-3 py-2 font-medium text-brand-800 hover:bg-brand-50 dark:text-brand-100 dark:hover:bg-brand-800">
                  {link.label}
                </a>
              )}
            </li>
          ))}
        </ul>
      </nav>
    </details>

    <nav class="hidden lg:block" aria-label="Primary navigation">
      <ul class="flex items-center gap-1 text-sm font-medium">
        {navLinks.map((link) => (
          <li class="relative">
            {link.children ? (
              <details class="group/dd">
                <summary
                  class:list={[
                    "flex cursor-pointer list-none items-center gap-1 rounded-md px-3 py-2 [&::-webkit-details-marker]:hidden",
                    isActive(link.href)
                      ? "text-brand-800 font-semibold dark:text-brand-50"
                      : "text-brand-700 hover:text-brand-900 dark:text-brand-200 dark:hover:text-white",
                  ]}
                >
                  {link.label}
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
                  </svg>
                </summary>
                <ul class="absolute left-0 z-50 mt-1 w-56 rounded-xl border border-brand-200 bg-white p-2 shadow-lg dark:border-brand-800 dark:bg-brand-900">
                  {link.children.map((child) => (
                    <li>
                      <a href={child.href} class="block rounded-md px-3 py-2 text-sm text-brand-700 hover:bg-brand-50 dark:text-brand-200 dark:hover:bg-brand-800">
                        {child.label}
                      </a>
                    </li>
                  ))}
                </ul>
              </details>
            ) : (
              <a
                href={link.href}
                class:list={[
                  "rounded-md px-3 py-2",
                  isActive(link.href)
                    ? "text-brand-800 font-semibold dark:text-brand-50"
                    : "text-brand-700 hover:text-brand-900 dark:text-brand-200 dark:hover:text-white",
                ]}
              >
                {link.label}
              </a>
            )}
          </li>
        ))}
      </ul>
    </nav>
  </div>
</header>

<script>
  const themeToggle = document.querySelector<HTMLButtonElement>("[data-theme-toggle]");
  themeToggle?.addEventListener("click", () => {
    const isDark = document.documentElement.classList.toggle("dark");
    localStorage.setItem("theme", isDark ? "dark" : "light");
  });
</script>

<script>
  // Close any open <details> dropdowns when clicking outside of them.
  document.addEventListener("click", (event) => {
    const target = event.target as Node;
    document.querySelectorAll("header details[open]").forEach((el) => {
      if (!el.contains(target)) el.removeAttribute("open");
    });
  });
</script>

<script>
  interface SearchRecord {
    type: string;
    title: string;
    excerpt: string;
    url: string;
    date: string | null;
  }

  const typeLabels: Record<string, string> = {
    news: "News",
    events: "Event",
    faq: "FAQ",
    resources: "Resource",
    newsletters: "Newsletter",
    gallery: "Gallery",
    pages: "Page",
  };

  const panel = document.querySelector<HTMLElement>("[data-search-panel]");
  const details = panel?.closest("details");
  const input = document.querySelector<HTMLInputElement>("[data-search-input]");
  const resultsEl = document.querySelector<HTMLUListElement>("[data-search-results]");
  const emptyEl = document.querySelector<HTMLElement>("[data-search-empty]");
  const hintEl = document.querySelector<HTMLElement>("[data-search-hint]");

  if (details && input && resultsEl && emptyEl && hintEl) {
    let index: SearchRecord[] | null = null;
    let loadPromise: Promise<void> | null = null;

    function loadIndex(): Promise<void> {
      if (loadPromise) return loadPromise;
      loadPromise = fetch("/search-index.json")
        .then((res) => res.json())
        .then((data: SearchRecord[]) => {
          index = data;
        })
        .catch(() => {
          index = [];
        });
      return loadPromise;
    }

    function score(record: SearchRecord, query: string): number {
      const title = record.title.toLowerCase();
      const excerpt = record.excerpt.toLowerCase();
      if (title === query) return 100;
      if (title.startsWith(query)) return 80;
      if (title.includes(query)) return 60;
      if (excerpt.includes(query)) return 20;
      return 0;
    }

    function renderResults(query: string) {
      resultsEl!.replaceChildren();
      const trimmed = query.trim().toLowerCase();
      hintEl!.classList.toggle("hidden", trimmed.length > 0);

      if (!trimmed || !index) {
        emptyEl!.classList.add("hidden");
        return;
      }

      const matches = index
        .map((record) => ({ record, s: score(record, trimmed) }))
        .filter((m) => m.s > 0)
        .sort((a, b) => b.s - a.s)
        .slice(0, 20);

      emptyEl!.classList.toggle("hidden", matches.length > 0);

      matches.forEach(({ record }) => {
        const li = document.createElement("li");
        const a = document.createElement("a");
        a.href = record.url;
        a.className = "block rounded-md px-3 py-2 hover:bg-brand-50 dark:hover:bg-brand-800";

        const typeSpan = document.createElement("span");
        typeSpan.className = "text-xs font-semibold uppercase tracking-wide text-accent-600 dark:text-accent-300";
        typeSpan.textContent = typeLabels[record.type] ?? record.type;

        const titleSpan = document.createElement("span");
        titleSpan.className = "block font-medium text-brand-900 dark:text-brand-50";
        titleSpan.textContent = record.title;

        a.append(typeSpan, titleSpan);

        if (record.excerpt) {
          const excerptSpan = document.createElement("span");
          excerptSpan.className = "block text-sm text-brand-600 dark:text-brand-300";
          excerptSpan.textContent = record.excerpt;
          a.append(excerptSpan);
        }

        li.append(a);
        resultsEl!.append(li);
      });
    }

    let debounceTimer: ReturnType<typeof setTimeout>;
    input.addEventListener("input", () => {
      clearTimeout(debounceTimer);
      const query = input.value;
      debounceTimer = setTimeout(() => renderResults(query), 150);
    });

    details.addEventListener("toggle", () => {
      if (details.open) {
        loadIndex().then(() => renderResults(input.value));
        input.focus();
      }
    });

    details.addEventListener("keydown", (event) => {
      if (event.key === "Escape") {
        details.removeAttribute("open");
      }
    });
  }
</script>
