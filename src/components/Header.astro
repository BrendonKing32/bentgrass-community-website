---
const navLinks = [
  { label: "Home", href: "/" },
  { label: "News", href: "/news-announcements" },
  { label: "Events", href: "/events-calendar" },
  {
    label: "Community Resources",
    href: "/community-resources/general-resources",
    children: [
      { label: "General Resources", href: "/community-resources/general-resources" },
      { label: "WHMD Information", href: "/community-resources/whmd-information" },
      { label: "BGMD Information", href: "/community-resources/bgmd-information" },
      { label: "Monthly Newsletters", href: "/community-resources/monthly-newsletters" },
    ],
  },
  { label: "FAQ", href: "/faq" },
  { label: "Gallery", href: "/community-gallery" },
  { label: "Contact", href: "/contact-get-involved" },
];

const currentPath = Astro.url.pathname.replace(/\/$/, "") || "/";

function isActive(href: string) {
  const normalized = href.replace(/\/$/, "") || "/";
  return currentPath === normalized || (normalized !== "/" && currentPath.startsWith(normalized));
}
---

<header class="sticky top-0 z-50 border-b border-brand-200 bg-brand-50/95 backdrop-blur">
  <div class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-4 py-3 sm:px-6">
    <a href="/" class="flex items-center gap-2 font-display text-lg font-semibold text-brand-800">
      <span
        class="flex h-9 w-9 items-center justify-center rounded-full bg-brand-600 text-brand-50"
        aria-hidden="true"
      >
        🌾
      </span>
      Bent Grass Neighborhood
    </a>

    <details class="group relative lg:hidden">
      <summary
        class="flex cursor-pointer list-none items-center justify-center rounded-md border border-brand-300 p-2 text-brand-700 [&::-webkit-details-marker]:hidden"
        aria-label="Toggle menu"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </summary>
      <nav
        class="absolute right-0 z-50 mt-2 w-64 rounded-xl border border-brand-200 bg-white p-3 shadow-lg"
        aria-label="Mobile navigation"
      >
        <ul class="flex flex-col gap-1">
          {navLinks.map((link) => (
            <li>
              {link.children ? (
                <details>
                  <summary class="cursor-pointer rounded-md px-3 py-2 font-medium text-brand-800 hover:bg-brand-50 [&::-webkit-details-marker]:hidden">
                    {link.label}
                  </summary>
                  <ul class="ml-3 mt-1 flex flex-col gap-1 border-l border-brand-100 pl-3">
                    {link.children.map((child) => (
                      <li>
                        <a href={child.href} class="block rounded-md px-3 py-2 text-sm text-brand-700 hover:bg-brand-50">
                          {child.label}
                        </a>
                      </li>
                    ))}
                  </ul>
                </details>
              ) : (
                <a href={link.href} class="block rounded-md px-3 py-2 font-medium text-brand-800 hover:bg-brand-50">
                  {link.label}
                </a>
              )}
            </li>
          ))}
        </ul>
      </nav>
    </details>

    <nav class="hidden lg:block" aria-label="Primary navigation">
      <ul class="flex items-center gap-1 text-sm font-medium">
        {navLinks.map((link) => (
          <li class="relative">
            {link.children ? (
              <details class="group/dd">
                <summary
                  class:list={[
                    "flex cursor-pointer list-none items-center gap-1 rounded-md px-3 py-2 [&::-webkit-details-marker]:hidden",
                    isActive(link.href) ? "text-brand-800 font-semibold" : "text-brand-700 hover:text-brand-900",
                  ]}
                >
                  {link.label}
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
                  </svg>
                </summary>
                <ul class="absolute left-0 z-50 mt-1 w-56 rounded-xl border border-brand-200 bg-white p-2 shadow-lg">
                  {link.children.map((child) => (
                    <li>
                      <a href={child.href} class="block rounded-md px-3 py-2 text-sm text-brand-700 hover:bg-brand-50">
                        {child.label}
                      </a>
                    </li>
                  ))}
                </ul>
              </details>
            ) : (
              <a
                href={link.href}
                class:list={[
                  "rounded-md px-3 py-2",
                  isActive(link.href) ? "text-brand-800 font-semibold" : "text-brand-700 hover:text-brand-900",
                ]}
              >
                {link.label}
              </a>
            )}
          </li>
        ))}
      </ul>
    </nav>
  </div>
</header>

<script>
  // Close any open <details> dropdowns when clicking outside of them.
  document.addEventListener("click", (event) => {
    const target = event.target as Node;
    document.querySelectorAll("header details[open]").forEach((el) => {
      if (!el.contains(target)) el.removeAttribute("open");
    });
  });
</script>
