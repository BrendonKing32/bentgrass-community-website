---
import { render } from "astro:content";
import type { CollectionEntry } from "astro:content";
import { Image } from "astro:assets";

interface Props {
  entry: CollectionEntry<"events">;
  past?: boolean;
}

const { entry, past = false } = Astro.props;
const { Content } = await render(entry);
const { title, date, endDate, time, location, link, linkLabel, coverImage, coverImageAlt } = entry.data;

const dateOptions: Intl.DateTimeFormatOptions = { weekday: "long", year: "numeric", month: "long", day: "numeric" };
const dateLabel = endDate
  ? `${date.toLocaleDateString("en-US", { month: "long", day: "numeric" })} – ${endDate.toLocaleDateString("en-US", { month: "long", day: "numeric", year: "numeric" })}`
  : date.toLocaleDateString("en-US", dateOptions);
---

<article
  class:list={[
    "overflow-hidden rounded-2xl border shadow-sm",
    past
      ? "border-brand-200 bg-brand-50/60 dark:border-brand-800 dark:bg-brand-900/40"
      : "border-brand-200 bg-white dark:border-brand-800 dark:bg-brand-900",
  ]}
>
  {coverImage && (
    <Image
      src={coverImage}
      alt={coverImageAlt ?? title}
      width={640}
      height={360}
      class="aspect-video w-full object-cover"
      loading="lazy"
    />
  )}
  <div class="p-6">
    <div class="flex flex-wrap items-baseline justify-between gap-2">
      <h3 class="font-display text-xl font-semibold text-brand-900 dark:text-brand-50">{entry.data.title}</h3>
      {!past && <span class="rounded-full bg-accent-100 px-3 py-1 text-xs font-semibold text-accent-800 dark:bg-accent-900 dark:text-accent-200">Upcoming</span>}
    </div>
    <p class="mt-1 text-sm font-medium text-brand-600 dark:text-brand-300">
      {dateLabel}{time && ` · ${time}`}
    </p>
    {location && <p class="text-sm text-brand-600 dark:text-brand-300">{location}</p>}
    <div class="prose prose-sm mt-3 max-w-none text-brand-800 dark:text-brand-100">
      <Content />
    </div>
    {link && (
      <a href={link} target="_blank" rel="noopener" class="mt-3 inline-flex items-center gap-1 text-sm font-semibold text-brand-700 hover:text-brand-900 dark:text-brand-200 dark:hover:text-white">
        {linkLabel ?? "Learn more"}
        <span aria-hidden="true">&rarr;</span>
      </a>
    )}
  </div>
</article>
