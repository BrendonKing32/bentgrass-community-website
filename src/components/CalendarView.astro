---
import { render } from "astro:content";
import type { CollectionEntry } from "astro:content";

interface Props {
  events: CollectionEntry<"events">[];
}

const { events } = Astro.props;
const renderedEvents = await Promise.all(
  events.map(async (entry) => ({ entry, Content: (await render(entry)).Content }))
);

const eventData = events.map((entry) => {
  const dateKey = entry.data.date.toISOString().slice(0, 10);
  const endDateKey = (entry.data.endDate ?? entry.data.date).toISOString().slice(0, 10);

  return {
    id: entry.id,
    title: entry.data.title,
    dateKey,
    endDateKey,
    time: entry.data.time ?? "",
    location: entry.data.location ?? "",
  };
});
---

<section class="mx-auto max-w-6xl px-4 py-10 sm:px-6" data-calendar>
  <div class="rounded-2xl border border-brand-200 bg-white p-4 shadow-sm sm:p-6">
    <div class="flex items-center justify-between gap-3">
      <button
        type="button"
        data-calendar-prev
        class="rounded-md border border-brand-300 px-3 py-2 text-sm font-semibold text-brand-700 hover:bg-brand-50 focus:outline-none focus:ring-2 focus:ring-accent-400 focus:ring-offset-2"
        aria-label="Previous month"
      >
        <span aria-hidden="true">&larr;</span>
        <span class="sr-only sm:not-sr-only sm:ml-1">Previous</span>
      </button>
      <h2 id="calendar-month-label" class="font-display text-xl font-semibold text-brand-900 sm:text-2xl" aria-live="polite"></h2>
      <button
        type="button"
        data-calendar-next
        class="rounded-md border border-brand-300 px-3 py-2 text-sm font-semibold text-brand-700 hover:bg-brand-50 focus:outline-none focus:ring-2 focus:ring-accent-400 focus:ring-offset-2"
        aria-label="Next month"
      >
        <span class="sr-only sm:not-sr-only sm:mr-1">Next</span>
        <span aria-hidden="true">&rarr;</span>
      </button>
    </div>

    <div class="mt-5 grid grid-cols-7 border-b border-brand-200 text-center text-xs font-semibold uppercase tracking-wide text-brand-600" aria-hidden="true">
      <span class="pb-2">Sun</span>
      <span class="pb-2">Mon</span>
      <span class="pb-2">Tue</span>
      <span class="pb-2">Wed</span>
      <span class="pb-2">Thu</span>
      <span class="pb-2">Fri</span>
      <span class="pb-2">Sat</span>
    </div>
    <div data-calendar-grid class="mt-2 grid grid-cols-7 gap-1" role="grid" aria-labelledby="calendar-month-label"></div>

    <div data-calendar-details class="mt-6 border-t border-brand-200 pt-6" aria-live="polite"></div>
  </div>

  <div id="calendar-event-templates" class="hidden" aria-hidden="true">
    {renderedEvents.map(({ entry, Content }) => {
      const { title, date, endDate, time, location, link, linkLabel } = entry.data;
      const dateLabel = endDate
        ? `${date.toLocaleDateString("en-US", { month: "long", day: "numeric" })} – ${endDate.toLocaleDateString("en-US", { month: "long", day: "numeric", year: "numeric" })}`
        : date.toLocaleDateString("en-US", { month: "long", day: "numeric", year: "numeric" });

      return (
        <article data-event-template={entry.id} class="hidden rounded-xl border border-brand-200 bg-brand-50/50 p-5">
          <div class="flex flex-wrap items-start justify-between gap-3">
            <div>
              <h3 class="font-display text-xl font-semibold text-brand-900">{title}</h3>
              <p class="mt-1 text-sm font-medium text-brand-600">{dateLabel}{time && ` · ${time}`}</p>
              {location && <p class="text-sm text-brand-600">{location}</p>}
            </div>
            <button
              type="button"
              data-calendar-download={entry.id}
              class="rounded-md border border-brand-300 bg-white px-3 py-2 text-sm font-semibold text-brand-700 hover:bg-brand-50 focus:outline-none focus:ring-2 focus:ring-accent-400 focus:ring-offset-2"
            >
              Download .ics
            </button>
          </div>
          <div class="prose prose-sm mt-4 max-w-none text-brand-800">
            <Content />
          </div>
          {link && (
            <a href={link} target="_blank" rel="noopener" class="mt-4 inline-flex items-center gap-1 text-sm font-semibold text-brand-700 hover:text-brand-900">
              {linkLabel ?? "Learn more"}
              <span aria-hidden="true">&rarr;</span>
            </a>
          )}
        </article>
      );
    })}
  </div>

  <noscript>
    <p class="mt-4 rounded-md bg-accent-50 p-4 text-sm text-accent-800">Enable JavaScript to browse the calendar. The events are listed in the page source.</p>
  </noscript>
</section>

<script is:inline type="application/json" id="calendar-events" set:html={JSON.stringify(eventData)} />

<script>
  const calendar = document.querySelector<HTMLElement>("[data-calendar]");
  const eventDataElement = document.querySelector<HTMLScriptElement>("#calendar-events");

  if (calendar && eventDataElement) {
    const events = JSON.parse(eventDataElement.textContent || "[]") as Array<{
      id: string;
      title: string;
      dateKey: string;
      endDateKey: string;
      time: string;
      location: string;
    }>;
    const grid = calendar.querySelector<HTMLElement>("[data-calendar-grid]");
    const details = calendar.querySelector<HTMLElement>("[data-calendar-details]");
    const monthLabel = calendar.querySelector<HTMLElement>("#calendar-month-label");
    const templates = document.querySelector<HTMLElement>("#calendar-event-templates");
    const today = new Date();
    let viewDate = new Date(today.getFullYear(), today.getMonth(), 1);
    let selectedKey = `${today.getFullYear()}-${String(today.getMonth() + 1).padStart(2, "0")}-${String(today.getDate()).padStart(2, "0")}`;

    const dateKey = (date: Date) =>
      `${date.getFullYear()}-${String(date.getMonth() + 1).padStart(2, "0")}-${String(date.getDate()).padStart(2, "0")}`;

    const eventsForDay = (key: string) => events.filter((event) => event.dateKey <= key && event.endDateKey >= key);

    const escapeIcs = (value: string) => value.replace(/([\\;,])/g, "\\$1").replace(/\r?\n/g, "\\n");

    const parseTimedDate = (key: string, time: string) => {
      const [year, month, day] = key.split("-").map(Number);
      const match = time.trim().match(/^(\d{1,2})(?::(\d{2}))?\s*(AM|PM)?/i);
      if (!match) return new Date(year, month - 1, day);

      let hour = Number(match[1]);
      const minute = Number(match[2] || 0);
      const meridiem = match[3]?.toUpperCase();
      if (meridiem === "PM" && hour < 12) hour += 12;
      if (meridiem === "AM" && hour === 12) hour = 0;
      return new Date(year, month - 1, day, hour, minute);
    };

    const formatIcsDate = (date: Date) =>
      `${date.getFullYear()}${String(date.getMonth() + 1).padStart(2, "0")}${String(date.getDate()).padStart(2, "0")}`;

    const formatIcsDateTime = (date: Date) =>
      `${formatIcsDate(date)}T${String(date.getHours()).padStart(2, "0")}${String(date.getMinutes()).padStart(2, "0")}00`;

    const downloadIcs = (eventId: string) => {
      const event = events.find((candidate) => candidate.id === eventId);
      if (!event) return;

      const allDay = !event.time;
      let startLine: string;
      let endLine: string;
      if (allDay) {
        const endDate = new Date(`${event.endDateKey}T00:00:00`);
        endDate.setDate(endDate.getDate() + 1);
        startLine = `DTSTART;VALUE=DATE:${event.dateKey.replaceAll("-", "")}`;
        endLine = `DTEND;VALUE=DATE:${formatIcsDate(endDate)}`;
      } else {
        const start = parseTimedDate(event.dateKey, event.time);
        const end = parseTimedDate(event.endDateKey, event.time);
        if (end <= start) end.setTime(start.getTime() + 60 * 60 * 1000);
        startLine = `DTSTART:${formatIcsDateTime(start)}`;
        endLine = `DTEND:${formatIcsDateTime(end)}`;
      }

      const ics = [
        "BEGIN:VCALENDAR",
        "VERSION:2.0",
        "PRODID:-//Bent Grass Neighborhood//Events//EN",
        "BEGIN:VEVENT",
        `UID:${escapeIcs(event.id)}@bentgrassneighborhood.org`,
        `DTSTAMP:${formatIcsDateTime(new Date())}`,
        startLine,
        endLine,
        `SUMMARY:${escapeIcs(event.title)}`,
        ...(event.location ? [`LOCATION:${escapeIcs(event.location)}`] : []),
        "END:VEVENT",
        "END:VCALENDAR",
        "",
      ].join("\r\n");
      const blob = new Blob([ics], { type: "text/calendar;charset=utf-8" });
      const url = URL.createObjectURL(blob);
      const anchor = document.createElement("a");
      anchor.href = url;
      anchor.download = `${event.title.toLowerCase().replace(/[^a-z0-9]+/g, "-").replace(/^-|-$/g, "") || "event"}.ics`;
      anchor.click();
      URL.revokeObjectURL(url);
    };

    const renderDetails = () => {
      if (!details || !templates) return;
      const dayEvents = eventsForDay(selectedKey);
      details.replaceChildren();
      const heading = document.createElement("h2");
      heading.className = "font-display text-xl font-semibold text-brand-900";
      const selectedDate = new Date(`${selectedKey}T12:00:00`);
      heading.textContent = selectedDate.toLocaleDateString("en-US", { weekday: "long", month: "long", day: "numeric" });
      details.append(heading);

      if (dayEvents.length === 0) {
        const empty = document.createElement("p");
        empty.className = "mt-2 text-brand-600";
        empty.textContent = "No events scheduled for this day.";
        details.append(empty);
        return;
      }

      const eventList = document.createElement("div");
      eventList.className = "mt-4 grid gap-4 md:grid-cols-2";
      dayEvents.forEach((event) => {
        const template = templates.querySelector<HTMLElement>(`[data-event-template="${CSS.escape(event.id)}"]`);
        if (!template) return;
        const copy = template.cloneNode(true) as HTMLElement;
        copy.classList.remove("hidden");
        copy.querySelector<HTMLButtonElement>("[data-calendar-download]")?.addEventListener("click", () => downloadIcs(event.id));
        eventList.append(copy);
      });
      details.append(eventList);
    };

    const renderCalendar = () => {
      if (!grid || !monthLabel) return;
      monthLabel.textContent = viewDate.toLocaleDateString("en-US", { month: "long", year: "numeric" });
      grid.replaceChildren();
      const firstDay = new Date(viewDate.getFullYear(), viewDate.getMonth(), 1).getDay();
      const daysInMonth = new Date(viewDate.getFullYear(), viewDate.getMonth() + 1, 0).getDate();

      for (let index = 0; index < firstDay; index += 1) {
        const blank = document.createElement("div");
        blank.className = "min-h-20 rounded-md bg-brand-50/40 sm:min-h-24";
        blank.setAttribute("aria-hidden", "true");
        grid.append(blank);
      }

      for (let day = 1; day <= daysInMonth; day += 1) {
        const key = dateKey(new Date(viewDate.getFullYear(), viewDate.getMonth(), day));
        const dayEvents = eventsForDay(key);
        const button = document.createElement("button");
        button.type = "button";
        button.dataset.dayKey = key;
        button.className = "flex min-h-20 flex-col items-start rounded-md border border-brand-200 bg-white p-2 text-left hover:border-brand-400 hover:bg-brand-50 focus:outline-none focus:ring-2 focus:ring-accent-400 focus:ring-inset sm:min-h-24";
        button.setAttribute("role", "gridcell");
        button.setAttribute("aria-label", `${new Date(`${key}T12:00:00`).toLocaleDateString("en-US", { month: "long", day: "numeric", year: "numeric" })}${dayEvents.length ? `, ${dayEvents.length} event${dayEvents.length === 1 ? "" : "s"}` : ""}`);
        const number = document.createElement("span");
        number.className = "text-sm font-semibold text-brand-800";
        number.textContent = String(day);
        button.append(number);

        if (dayEvents.length) {
          const eventLabels = document.createElement("span");
          eventLabels.className = "mt-1 line-clamp-2 text-xs font-medium text-accent-800";
          eventLabels.textContent = dayEvents.map((event) => event.title).join(" · ");
          button.append(eventLabels);
        }
        button.addEventListener("click", () => {
          selectedKey = key;
          renderCalendar();
          renderDetails();
        });
        grid.append(button);
      }

      grid.querySelector<HTMLElement>(`[data-day-key="${CSS.escape(selectedKey)}"]`)?.classList.add("border-accent-500", "bg-accent-50");
    };

    calendar.querySelector<HTMLButtonElement>("[data-calendar-prev]")?.addEventListener("click", () => {
      viewDate = new Date(viewDate.getFullYear(), viewDate.getMonth() - 1, 1);
      renderCalendar();
      renderDetails();
    });
    calendar.querySelector<HTMLButtonElement>("[data-calendar-next]")?.addEventListener("click", () => {
      viewDate = new Date(viewDate.getFullYear(), viewDate.getMonth() + 1, 1);
      renderCalendar();
      renderDetails();
    });

    renderCalendar();
    renderDetails();
  }
</script>
